<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/background_dark">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="35"
        android:orientation="vertical"
        android:background="@color/bg_card"
        android:padding="15dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="170dp"
                android:layout_height="150dp"
                android:src="@drawable/logo_hasdrubal_w"
                android:contentDescription="hasdrubal logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hotel_name"
                android:textColor="@color/gold"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hotel_location"
                android:textColor="@color/hasdrubal_blue_light"
                android:textSize="16sp"
                android:textAllCaps="true"
                android:letterSpacing="0.15"
                android:layout_marginTop="5dp" />

            <View
                android:layout_width="50dp"
                android:layout_height="1dp"
                android:background="@color/gold"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enquête de satisfaction"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:gravity="center"
                android:lineSpacingExtra="4dp" />

            <TextView
                android:id="@+id/tv_device_ip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/skip_color"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginTop="20dp" />

        </LinearLayout>

        <ImageView
            android:layout_width="180dp"
            android:layout_height="70dp"
            android:src="@drawable/img"
            android:contentDescription="Iti"
            android:layout_gravity="center_horizontal"
            />

    </LinearLayout>

    <!-- VERTICAL DIVIDER -->
    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@color/divider" />

    <!-- RIGHT PANEL — guest info + 3 buttons (65%) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="65"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="36dp"
        android:paddingEnd="36dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bienvenue !"
            android:textColor="@color/white"
            android:textSize="40sp"
            android:textStyle="bold"
            android:fontFamily="serif" />

        <!-- Guest name — visible only when IP matched -->
        <TextView
            android:id="@+id/tv_guest_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/gold"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <!-- Room number — visible only when IP matched -->
        <TextView
            android:id="@+id/tv_room_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/hasdrubal_blue_light"
            android:textSize="18sp"
            android:textAllCaps="true"
            android:letterSpacing="0.1"
            android:layout_marginTop="4dp"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Votre satisfaction est notre priorité."
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:fontFamily="serif"
            android:textStyle="italic"
            android:layout_marginTop="10dp" />

        <View
            android:layout_width="70dp"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp" />

        <!-- 3 action buttons — equal weight, fill parent width -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_start_now"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Commencer"
                android:textSize="15sp"
                android:textColor="@color/background_dark"
                android:backgroundTint="@color/gold"
                android:focusable="true"
                android:nextFocusRight="@+id/btn_maybe_later"
                android:nextFocusLeft="@+id/btn_never" />

            <Button
                android:id="@+id/btn_maybe_later"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Plus tard"
                android:textSize="15sp"
                android:textColor="@color/white"
                android:backgroundTint="@color/hasdrubal_blue"
                android:focusable="true"
                android:layout_marginStart="12dp"
                android:nextFocusLeft="@+id/btn_start_now"
                android:nextFocusRight="@+id/btn_never" />

            <Button
                android:id="@+id/btn_never"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Jamais"
                android:textSize="15sp"
                android:textColor="@color/white"
                android:backgroundTint="@color/skip_color"
                android:focusable="true"
                android:layout_marginStart="12dp"
                android:nextFocusLeft="@+id/btn_maybe_later"
                android:nextFocusRight="@+id/btn_start_now" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="◄ ► Naviguer   |   OK pour Confirmer"
            android:textColor="@color/skip_color"
            android:textSize="15sp"
            android:layout_marginTop="16dp" />


    </LinearLayout>

</LinearLayout>
