<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/background_dark">

    <!-- LEFT : branding Hasdrubal -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="35"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@color/bg_card"
        android:padding="32dp">

        <ImageView
            android:layout_width="170dp"
            android:layout_height="150dp"
            android:src="@drawable/logo_hasdrubal_w"
            android:contentDescription="hasdrubal Logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hotel_name"
            android:textColor="@color/gold"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hotel_location"
            android:textColor="@color/hasdrubal_blue_light"
            android:textSize="16sp"
            android:textAllCaps="true"
            android:letterSpacing="0.15"
            android:layout_marginTop="4dp" />

    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@color/divider" />

    <!-- RIGHT : message de remerciement (textes dynamiques par langue) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="65"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="48dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✓"
            android:textColor="@color/gold"
            android:textSize="72sp" />

        <!-- Titre : "Merci !" / "Thank you!" / … -->
        <TextView
            android:id="@+id/tv_thanks_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="44sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:gravity="center"
            android:layout_marginTop="12dp" />

        <!-- Slogan localisé -->
        <TextView
            android:id="@+id/tv_thanks_slogan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/gold"
            android:textSize="18sp"
            android:textStyle="italic"
            android:fontFamily="serif"
            android:gravity="center"
            android:layout_marginTop="8dp" />

        <View
            android:layout_width="80dp"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp" />

        <!-- Nom du client (visible si identifié) -->
        <TextView
            android:id="@+id/tv_guest_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/gold"
            android:textSize="16sp"
            android:textStyle="italic"
            android:gravity="center"
            android:layout_marginBottom="10dp"
            android:visibility="gone" />

        <!-- Corps localisé -->
        <TextView
            android:id="@+id/tv_thanks_body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="18sp"
            android:gravity="center"
            android:lineSpacingExtra="6dp" />

        <!-- Compte à rebours localisé -->
        <TextView
            android:id="@+id/tv_thanks_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/skip_color"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginTop="36dp" />

    </LinearLayout>

</LinearLayout>
